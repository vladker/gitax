# GitHub Archiver — configuration template
# Copy to config.yaml and fill in your values.
# Sensitive values (tokens, URLs) should go in .env instead.

github:
  # GitHub personal access token — prefer GITHUB_TOKEN env var
  token: ""

max:
  # MAX Messenger channel URL — prefer MAX_CHANNEL_URL env var
  channel_url: ""

browser:
  # CDP port for connecting to existing Chrome instance
  cdp_port: 9222

archiver:
  # How many repositories to fetch from GitHub
  limit: 100
  # Upload retry count
  retries: 1
  # Delay between retries (seconds)
  retry_delay: 1
  # Pause between repositories (seconds)
  repo_delay: 0
  # Temporary directory for downloaded zip files
  output_dir: "./temp"
  # false = connect to existing Chrome via CDP, true = launch new browser
  use_local_browser: false
  # Split mode: auto (threshold-based), on (always split), off (never split), prompt (ask per-file)
  split_mode: auto
  # Files above this size (MB) are split into 7z volumes (only when split_mode=auto)
  split_threshold_mb: 49

pypi:
  # MAX channel URL for PyPI packages — prefer PYPI_CHANNEL_URL env var
  channel_url: ""

pypi_archiver:
  # How many packages to show in menu by default
  limit: 20
  # Temporary directory for PyPI files
  output_dir: "./temp_pypi"
  # Delay between download retries (seconds)
  retry_delay: 10
  # Number of attempts on download error
  retries: 3
